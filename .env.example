# Google Apps Script Web App URL (ends with /exec) — from Deploy > Manage deployments
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Shared secret — must EXACTLY match the Script Property APPS_SCRIPT_SECRET in Apps Script
APPS_SCRIPT_SECRET=change-me-to-a-long-random-string

# PIN for venue staff on /checkin (numbers only, 4-8 digits recommended)
CHECKIN_PIN=2910

# Public site URL, no trailing slash (used for Open Graph + share links)
NEXT_PUBLIC_SITE_URL=https://dac-invite.vercel.app
